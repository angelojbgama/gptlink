# Environment: development permits HTTP/WS; production requires HTTPS/WSS.
GPTLINK_ENV=development
GPTLINK_GATEWAY_HOST=127.0.0.1
GPTLINK_GATEWAY_PORT=8000
GPTLINK_GATEWAY_URL=http://127.0.0.1:8000
GPTLINK_DATABASE_URL=sqlite+aiosqlite:///./gptlink.db
# Generate a unique value with at least 32 characters; never commit the real value.
GPTLINK_MCP_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
GPTLINK_MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]
GPTLINK_MCP_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*"]

# Keep this list empty until the Agent is deliberately granted a directory.
GPTLINK_AGENT_ROOTS=[]
GPTLINK_AGENT_PERMISSION_LEVEL=READ_ONLY

# Optional local chat bridge. Keep ChatGPT-Web2API in a separate virtual environment.
GPTLINK_CHAT_BACKEND=web2api
GPTLINK_WEB2API_URL=http://127.0.0.1:8081
